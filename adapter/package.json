{
  "name": "herdr-vibe-integration",
  "version": "0.1.0",
  "description": "Herdr integration adapter for Mistral Vibe",
  "main": "dist/index.js",
  "bin": {
    "vibe-herdr": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "herdr",
    "vibe",
    "mistral",
    "agent",
    "integration",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "^2.1.3"
  }
}
