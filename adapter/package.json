{
  "name": "herdr-vibe-integration",
  "version": "0.1.0",
  "description": "Herdr integration adapter for Mistral Vibe",
  "main": "dist/index.js",
  "bin": {
    "vibe-herdr": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint:ts": "oxlint src",
    "lint:ts:fix": "oxlint src --fix",
    "lint": "run-p lint:ts typecheck",
    "lint:fix": "run-p lint:ts:fix",
    "check": "run-s typecheck lint build"
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=11.24.0"
  },
  "keywords": [
    "herdr",
    "vibe",
    "mistral",
    "agent",
    "integration",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "2.1.3"
  }
}
